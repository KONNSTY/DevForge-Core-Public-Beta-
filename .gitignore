# OS
.DS_Store
Thumbs.db

# Environment files (keep .env.example)
.env
.env.*
!.env.example
!frontend/.env.example

# --- Frontend (Next.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
