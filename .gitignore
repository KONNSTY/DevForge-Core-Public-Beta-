frontend/.vercel

# --- Backend (.NET) ---
backend/bin/
backend/obj/
backend/*.db
backend/*.db-shm
backend/*.db-wal

# Stray local artifacts accidentally created under backend/ (not project files)
backend/.local/
backend/.nuget/
backend/Library/

# Logs
*.log
npm-debug.log*
